{
  "name": "@imjohnbo/kit-cli",
  "version": "0.0.1",
  "description": "A fully featured CLI for the Kit (ConvertKit) email marketing API",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/imjohnbo/kit-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjohnbo/kit-cli.git"
  },
  "bugs": {
    "url": "https://github.com/imjohnbo/kit-cli/issues"
  },
  "bin": {
    "kit": "./bin/kit.js"
  },
  "files": [
    "bin/",
    "src/",
    "skills/"
  ],
  "scripts": {
    "start": "node bin/kit.js",
    "test": "node scripts/run-tests.js",
    "test:file": "node --test",
    "surface": "node scripts/cli-surface.js --write",
    "check:semver": "node scripts/check-semver.js"
  },
  "keywords": [
    "kit",
    "convertkit",
    "email",
    "marketing",
    "cli",
    "api",
    "newsletter",
    "subscribers",
    "broadcasts",
    "claude-code"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "conf": "^13.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
